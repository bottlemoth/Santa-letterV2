# Skopiuj do .env i uzupełnij:  cp .env.example .env
# NIE commituj pliku .env — zawiera sekrety.

# --- Aplikacja ---
NODE_ENV=production
PORT=3000
# Port na hoście, pod którym będzie dostępna aplikacja (Docker Compose)
APP_PORT=3000
# Długi, losowy sekret sesji, np.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=zmien-mnie-na-dlugi-losowy-ciag-znakow
# Ustaw na true, gdy aplikacja jest serwowana przez HTTPS (np. za reverse proxy)
COOKIE_SECURE=false
# Ustaw na 1, gdy aplikacja stoi za reverse proxy (nginx, traefik)
TRUST_PROXY=0
# Maksymalny rozmiar zdjęcia w bajtach (domyślnie 5 MB)
MAX_UPLOAD_BYTES=5242880

# --- PostgreSQL (używane przez kontener db oraz aplikację) ---
POSTGRES_USER=santa
POSTGRES_PASSWORD=zmien-mnie-silne-haslo
POSTGRES_DB=santa_letter

# --- Uruchamianie poza Dockerem (npm start / npm test na hoście) ---
# W Docker Compose DATABASE_URL jest budowany automatycznie z hostem "db".
DATABASE_URL=postgres://santa:zmien-mnie-silne-haslo@127.0.0.1:5433/santa_letter
TEST_DATABASE_URL=postgres://santa:zmien-mnie-silne-haslo@127.0.0.1:5433/santa_letter_test
# Port PostgreSQL wystawiony na hoście (tylko 127.0.0.1) — przydatny przy pracy lokalnej
DB_HOST_PORT=5433

# --- Produkcja (compose.prod.yaml) ---
# Domena wskazująca rekordem A na IP serwera — Caddy pobierze dla niej certyfikat HTTPS.
DOMAIN=santa.twojadomena.pl
